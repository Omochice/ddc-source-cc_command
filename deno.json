{
  "tasks": {
    "check": "deno check ./**/*.ts",
    "lint": "deno lint ./**/*.ts",
    "test": "deno test --allow-read --allow-write --allow-env ./denops/"
  },
  "lock": false,
  "fmt": {
    "exclude": [
      "CHANGELOG.md"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
